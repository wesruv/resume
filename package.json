{
  "name": "wes-resume",
  "version": "0.0.1",
  "description": "",
  "keywords": "",
  "license": "",
  "author": "",
  "scripts": {
    "browser-sync": "browser-sync",
    "bs:start": "browser-sync start -s --index='index.html' --port 2099 --no-ui",
    "bs:watch": "browser-sync start -s --index='index.html' --files='**/*.html, css-dist/**/*.css, **/*.js' --port 2099 --no-ui",
    "pcss:build": "postcss css/**/*.css --base css --dir css-dist --env production",
    "pcss:watch": "postcss css/**/*.css --base css --dir css-dist -w"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "browser-sync": "^2.27.11",
    "cssnano": "^9.9.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^16.2.0",
    "postcss-nested": "^9.0.1"
  }
}
